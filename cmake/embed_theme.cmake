# Keep the editable default theme as the only source of the embedded copy.
set(theme_root "${PROJECT_SOURCE_DIR}/themes/default")
file(GLOB_RECURSE theme_files CONFIGURE_DEPENDS LIST_DIRECTORIES false
    RELATIVE "${theme_root}" "${theme_root}/*")
list(SORT theme_files)
set(MIZUKI_THEME_FILES "")
set(MIZUKI_THEME_CONTENTS "")
set(theme_index 0)
foreach(relative IN LISTS theme_files)
    set(source "${theme_root}/${relative}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    file(READ "${source}" content HEX)
    # Keep each literal below MSVC's limit, including for large browser bundles.
    set(chunks "")
    string(LENGTH "${content}" hex_size)
    set(offset 0)
    while(offset LESS hex_size)
        math(EXPR chunk_size "${hex_size} - ${offset}")
        if(chunk_size GREATER 4096)
            set(chunk_size 4096)
        endif()
        string(SUBSTRING "${content}" ${offset} ${chunk_size} chunk)
        string(REGEX REPLACE "(..)" "\\\\x\\1" chunk "${chunk}")
        math(EXPR byte_size "${chunk_size} / 2")
        string(APPEND chunks "    std::string_view{\"${chunk}\", ${byte_size}},\n")
        math(EXPR offset "${offset} + ${chunk_size}")
    endwhile()
    if(NOT chunks)
        set(chunks "    std::string_view{},\n")
    endif()
    string(APPEND MIZUKI_THEME_CONTENTS
        "inline constexpr std::array kThemeContent${theme_index}{\n${chunks}};\n")
    string(HEX "${relative}" name)
    string(REGEX REPLACE "(..)" "\\\\x\\1" name "${name}")
    string(APPEND MIZUKI_THEME_FILES
        "    EmbeddedThemeFile{\"${name}\", kThemeContent${theme_index}},\n")
    math(EXPR theme_index "${theme_index} + 1")
endforeach()
configure_file("${PROJECT_SOURCE_DIR}/cmake/embedded_theme.hpp.in"
    "${CMAKE_CURRENT_BINARY_DIR}/generated/embedded_theme.hpp" @ONLY)
